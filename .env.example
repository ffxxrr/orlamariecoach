# Environment variables for local development

# Prisma / Postgres
# Example local Postgres URL (Docker Compose)
DATABASE_URL="postgresql://orla:orla@localhost:5432/orla_dev?schema=public"

# Next.js
NODE_ENV=development

# Analytics (optional dev flags)
ANALYTICS_PRIVACY_MODE=true
ANALYTICS_RETENTION_DAYS=365

# Admin dashboard auth (REQUIRED in production — login fails closed without these)
ADMIN_EMAIL="admin@orlamariecoach.com"
ADMIN_PASSWORD="change-me-in-production"
# Secret used to HMAC-sign admin session cookies. Must be >= 16 chars.
# Generate with: openssl rand -base64 32
SESSION_SECRET="dev-insecure-session-secret-change-me"

