# Environment variables for local development

# Prisma / Postgres
# Example local Postgres URL (Docker Compose)
DATABASE_URL="postgresql://orla:orla@localhost:5432/orla_dev?schema=public"

# Next.js
NODE_ENV=development

# Analytics (optional dev flags)
ANALYTICS_PRIVACY_MODE=true
ANALYTICS_RETENTION_DAYS=365

# Admin dashboard auth (REQUIRED in production — login fails closed without these)
ADMIN_EMAIL="admin@orlamariecoach.com"
ADMIN_PASSWORD="change-me-in-production"
# Secret used to HMAC-sign admin session cookies. Must be >= 16 chars.
# Generate with: openssl rand -base64 32
SESSION_SECRET="dev-insecure-session-secret-change-me"


# Contact form email (Namecheap Private Email SMTP for admin@orlamariecoach.com)
# Without these the form logs messages to the console in dev, and shows an error in production.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=admin@orlamariecoach.com
SMTP_PASSWORD=
# Optional: where enquiries go (defaults to SMTP_USER)
CONTACT_TO_EMAIL=
# Optional: where weekly blog drafts are emailed for approval (defaults to CONTACT_TO_EMAIL, then SMTP_USER).
# Orla's computer needs the SMTP_* lines above in .env.local for scripts/email-draft.js to send.
BLOG_DRAFT_EMAIL=
